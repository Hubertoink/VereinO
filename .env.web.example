# Copy to .env.web (ignored by Git). Generate both secrets independently:
# openssl rand -hex 32
# DB password: use hexadecimal here to avoid URL-escaping issues.
DB_PASSWORD=
SETUP_TOKEN=
# Local smoke test only. For public access use HTTPS and COOKIE_SECURE=true.
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Persistent 32-byte hex key for encrypted AI credentials (openssl rand -hex 32).
# Keep with database backups; do not rotate without re-encrypting stored credentials.
AI_ENCRYPTION_KEY=
